<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shelfy</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Shelfy.styles.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        #loading-bar-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            z-index: 9999;
            pointer-events: none;
        }
        #loading-bar {
            width: 0%;
            height: 100%;
            background-color: #0d6efd;
            transition: width 0.4s ease;
        }
    </style>
</head>
<body>
    <div id="loading-bar-container"><div id="loading-bar"></div></div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/shelfy.png" alt="Shelfy logo" class="me-2" style="height:32px; width:auto;" />
                    <span>Shelfy</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            var adminLevel = Context.Session.GetInt32("AdminLevel") ?? 0;
                            if (adminLevel == 1 || adminLevel == 2)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Members">Members</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="FineRules">Fine Rules</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="OPAC">Catalog</a>
                                </li>
                            }

                            if (Context.Session.GetInt32("UserId").HasValue)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Info">Account</a>
                                </li>
                            }
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    @if (Context.Session.GetInt32("UserId").HasValue)
                    {
                        <form class="d-flex" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Shelfy - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        window.addEventListener('beforeunload', function () {
            document.getElementById('loading-bar').style.width = '100%';
        });

        document.addEventListener('DOMContentLoaded', function () {
            const bar = document.getElementById('loading-bar');
            bar.style.width = '30%';
            setTimeout(() => { bar.style.width = '100%'; }, 100);
            setTimeout(() => { bar.style.width = '0%'; bar.style.transition = 'none'; }, 600);
            setTimeout(() => { bar.style.transition = 'width 0.4s ease'; }, 700);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
