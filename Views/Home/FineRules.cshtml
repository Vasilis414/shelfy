@model List<Shelfy.Models.FineRule>
@{
    ViewData["Title"] = "Fine Rules";
    var adminLevel = Context.Session.GetInt32("AdminLevel") ?? 0;
}

<style>
    .dashboard-topbar { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem; }
    .dashboard-topbar .page-button { min-width: 120px; }
    .page-button.active { background-color: #0d6efd; color: #fff; border-color: #0d6efd; }
    .dashboard-card { border: 1px solid #dee2e6; border-radius: 0.75rem; padding: 1.25rem; background: #fff; box-shadow: 0 0.4rem 1rem rgba(0, 0, 0, 0.04); }
    .dashboard-card table { width: 100%; border-collapse: collapse; }
    .dashboard-card table th, .dashboard-card table td { padding: 0.75rem; border-bottom: 1px solid #e9ecef; }
    .dashboard-card table th { background: #f8f9fa; text-align: left; }
</style>

<div class="dashboard-topbar">
    <a class="btn btn-outline-primary page-button" asp-controller="Home" asp-action="Index">Dashboard</a>
    <a class="btn btn-outline-primary page-button" asp-controller="Home" asp-action="Books">Books</a>
    <a class="btn btn-outline-primary page-button" asp-controller="Home" asp-action="Borrows">Borrows</a>
    <a class="btn btn-outline-primary page-button" asp-controller="Home" asp-action="Members">Members</a>
    <a class="btn btn-primary page-button active" asp-controller="Home" asp-action="FineRules">Fine Rules</a>
</div>

<div class="dashboard-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Fine Rules Management</h2>
            <p class="text-muted mb-0">Definition of fine accumulation rules. Super Admins can manage rules, while Admins can view them.</p>
        </div>
        @if (adminLevel == 2)
        {
            <button class="btn btn-success" type="button" data-bs-toggle="modal" data-bs-target="#addFineRuleModal">Add New Rule</button>
        }
    </div>
</div>

<div class="dashboard-card">
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Rule Title</th>
                    <th>Fee (€)</th>
                    <th>Interval (Days)</th>
                    @if (adminLevel == 2) { <th>Action</th> }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var rule in Model)
                    {
                        <tr>
                            <td>@rule.RuleId</td>
                            <td>@rule.Title</td>
                            <td>€@rule.Fee.ToString("0.00")</td>
                            <td>@rule.FeeInterval</td>
                            @if (adminLevel == 2)
                            {
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" 
                                            onclick="editFineRule(this)"
                                            data-id="@rule.RuleId"
                                            data-title="@rule.Title"
                                            data-fee="@rule.Fee"
                                            data-interval="@rule.FeeInterval">
                                        Edit
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="@(adminLevel == 2 ? 5 : 4)" class="text-center text-muted">No rules found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="addFineRuleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Fine Rule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addFineRuleForm">
                    <div class="mb-3">
                        <label class="form-label">Rule Title</label>
                        <input type="text" class="form-control" id="ruleTitle" placeholder="e.g. Standard, Aggressive" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fee (€)</label>
                        <input type="number" step="0.01" class="form-control" id="ruleFee" placeholder="0.00" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Interval (Days)</label>
                        <input type="number" class="form-control" id="ruleInterval" placeholder="1" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitAddFineRule()">Save Rule</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editFineRuleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Fine Rule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editRuleId" />
                <div class="mb-3">
                    <label class="form-label">Rule Title</label>
                    <input type="text" class="form-control" id="editRuleTitle" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Fee (€)</label>
                    <input type="number" step="0.01" class="form-control" id="editRuleFee" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Interval (Days)</label>
                    <input type="number" class="form-control" id="editRuleInterval" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitEditFineRule()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<script>
    function submitAddFineRule() {
        const title = document.getElementById('ruleTitle').value;
        const fee = document.getElementById('ruleFee').value;
        const interval = document.getElementById('ruleInterval').value;

        if (!title || !fee || !interval) {
            Swal.fire('Input Error', 'Please fill in all fields', 'warning');
            return;
        }

        fetch('/Home/AddFineRule', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `title=${encodeURIComponent(title)}&fee=${fee}&interval=${interval}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire('Success', data.message, 'success').then(() => {
                    location.reload();
                });
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        });
    }

    function editFineRule(button) {
        document.getElementById('editRuleId').value = button.dataset.id;
        document.getElementById('editRuleTitle').value = button.dataset.title;
        document.getElementById('editRuleFee').value = button.dataset.fee;
        document.getElementById('editRuleInterval').value = button.dataset.interval;

        var modal = new bootstrap.Modal(document.getElementById('editFineRuleModal'));
        modal.show();
    }

    function submitEditFineRule() {
        const ruleId = document.getElementById('editRuleId').value;
        const title = document.getElementById('editRuleTitle').value;
        const fee = document.getElementById('editRuleFee').value;
        const interval = document.getElementById('editRuleInterval').value;

        if (!title || !fee || !interval) {
            Swal.fire('Input Error', 'Please fill in all fields', 'warning');
            return;
        }

        fetch('/Home/EditFineRule', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `ruleId=${ruleId}&title=${encodeURIComponent(title)}&fee=${fee}&interval=${interval}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire('Success', data.message, 'success').then(() => {
                    location.reload();
                });
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        });
    }
</script>
